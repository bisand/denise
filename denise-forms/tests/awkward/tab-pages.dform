// Tabs that carry their own pages, and tabs that do not, in one file. A `tab`
// with a block holds that section's subtree; a `tab` without one is the strip a
// `tabs` node has always been, where the application shows and hides its own
// panels. Both spellings are here because both are legal and the round trip has
// to keep either.

form "Tab pages" version=1 kind=screen width=420 height=320 {
    tabs name=sections x=8 y=8 w=404 h=180 selected=1 on-change=pick {
        tab "First" {
            label "on the first page" x=8 y=8 w=200 h=20

            // A container inside a page nests like anywhere else.
            panel name=inner x=8 y=36 w=200 h=80 {
                button "Go" x=8 y=8 w=80 h=28
            }
        }

        // The file opens on this one -- `selected` counts tabs from zero.
        tab "Second" {
            label "on the second page" x=8 y=8 w=200 h=20
        }

        // A tab with nothing behind it yet, which is what a half-written form
        // looks like and still has to load.
        tab "Third"
    }

    // And a strip of the older kind, with no pages at all.
    tabs name=plain x=8 y=200 w=404 h=36 selected=0 {
        tab "One"
        tab "Two"
    }
}
