// The reference form: every node kind and every version-1 property, once.
//
// This is not a design. It is the fixture docs/forms.md is checked against and
// the file denise-forms' tests load — if a property exists in the schema and
// not in here, the schema and the engine can drift apart without anything
// noticing. Adding a property to the format means adding it to this file.
//
// Assets are resolved relative to this file, so the paths below reach the
// repository's real pictures and `denise-forms render` can draw it.
//
// One thing it cannot cover: a form has exactly one `kind`, so the properties
// that only a window, dialog, drawer or shelf carries are not exercised here.
// Those have a small file each beside this one — window.dform, dialog.dform,
// drawer.dform and shelf.dform — and CI checks every one of them.

form "Reference" name=reference version=1 kind=screen width=1024 height=600 theme=dark background=base-200 scaling=none {

    // ---------------------------------------------------------------- header

    panel name=header x=0 y=0 w=1024 h=56 fill=base-100 border=base-300 border-width=1 radius=box {
        label "DeniseUI" x=16 y=8 w=160 h=22 size=20 role=primary
        label "reference form" x=16 y=32 w=160 h=16 size=11 role=base-content align=start valign=center

        badge "v1" x=190 y=18 w=44 h=20 role=accent size=11

        // No message: it draws and does not emit.
        button "Docs" x=700 y=12 w=80 h=32 role=neutral

        button "Save" x=788 y=12 w=80 h=32 role=primary radius=field size=14 on-press=save tooltip="Write the form to disk"

        spinner name=busy x=880 y=16 w=24 h=24 role=info thickness=3 period-ms=900 frame-ms=100 visible=#false

        avatar name=me x=916 y=12 w=32 h=32 initials="André Biseth" role=secondary ring=primary presence=online size=13
    }

    // ------------------------------------------------------------------ left

    panel name=sidebar x=0 y=56 w=240 h=544 fill=base-100 {
        list name=nav x=8 y=8 w=224 h=200 selected=0 on-select=navigate on-activate=open activate-on-click=#true row-height=32 role=primary size=14 {
            item "Overview" leading="◆"
            item "Widgets" leading="◇" trailing="25"
            item "Themes" leading="◇"
            item "Not yet written" leading="◇" enabled=#false
        }

        divider x=8 y=216 w=224 h=16 role=base-300

        divider "History" x=8 y=236 w=224 h=16 role=base-content size=11

        timeline name=history x=8 y=256 w=224 h=140 row-height=32 size=12 {
            event "Parsed" time="09:14" role=success
            event "Built" time="09:14" role=success
            event "Painted" time="09:15" role=info
            event "Presented" pending=#true
        }

        // A vertical rule against the main area, to prove the orientation.
        divider x=232 y=8 w=1 h=520 orientation=vertical role=base-300

        collapse "Advanced" name=advanced x=8 y=404 w=224 h=40 open=#false expanded-height=96 on-toggle=advanced-toggled role=base-200 size=13 {
            checkbox "Verbose logging" x=12 y=8 w=200 h=24 on-change=set-verbose role=info size=12
            toggle "Kiosk mode" x=12 y=36 w=200 h=24 checked=#true on-change=set-kiosk role=warning size=12
        }

        // A stacked, scrolling column. `stack` places the children and the tree
        // overwrites their `y`, which is why they all declare y=0; and the
        // stacked height is more than twice the panel's, which is what `scroll`
        // is here to show.
        panel name=notes x=8 y=452 w=224 h=84 fill=base-200 radius=box scroll=#true stack=6 z=1 {
            label "The stack owns y" x=8 y=0 w=200 h=20 size=13 role=base-content
            label "Every child below declares y=0 and is placed by the parent." x=8 y=0 w=200 h=32 size=11 role=base-content valign=center
            divider x=8 y=0 w=200 h=8 role=base-300
            badge "one" x=8 y=0 w=60 h=20 role=info size=11
            badge "two" x=8 y=0 w=60 h=20 role=success size=11
            badge "three" x=8 y=0 w=60 h=20 role=error size=11
            button "Disabled" x=8 y=0 w=100 h=28 role=neutral size=12 enabled=#false
        }
    }

    // ------------------------------------------------------------------ main

    tabs name=sections x=248 y=64 w=768 h=36 selected=0 on-change=select-section role=primary size=14 {
        tab "Form"
        tab "Data"
        tab "Media"
    }

    alert "Nothing here is saved: this file is a fixture." x=248 y=108 w=768 h=36 role=info icon="i" size=13

    // The form section.

    panel name=form-section x=248 y=152 w=380 h=440 fill=base-100 radius=box {
        label "Details" x=16 y=12 w=200 h=20 size=15 role=base-content

        label "Name" x=16 y=44 w=120 h=16 size=12 role=base-content valign=center
        text-input name=full-name x=16 y=62 w=348 h=34 text="Ada Lovelace" placeholder="first and last" max-chars=64 on-submit=submit size=14 focus=#true

        label "Passphrase" x=16 y=104 w=120 h=16 size=12
        text-input name=secret x=16 y=122 w=348 h=34 placeholder="••••••••" password=#true size=14

        label "Role" x=16 y=164 w=120 h=16 size=12
        select name=job x=16 y=182 w=348 h=34 selected=1 placeholder="pick one" on-change=job-changed role=neutral size=14 {
            option "Reader"
            option "Author"
            option "Maintainer"
        }

        label "Delivery" x=16 y=224 w=120 h=16 size=12
        radio-group name=delivery x=16 y=242 w=348 h=76 selected=1 on-change=delivery-changed role=secondary size=13 {
            option "Immediately"
            option "Daily digest"
            option "Never"
        }

        checkbox "Send me release notes" name=notify x=16 y=326 w=348 h=24 checked=#true on-change=set-notify role=primary size=13

        toggle "Dark theme" name=dark x=16 y=356 w=348 h=24 checked=#true on-change=set-dark role=accent size=13

        label "Volume" x=16 y=388 w=120 h=16 size=12
        slider name=volume x=140 y=388 w=224 h=24 min=0 max=100 value=70 step=5 on-change=set-volume role=success

        rating name=stars x=16 y=414 w=140 h=24 value=4 max=5 on-change=rate clearable=#true role=warning

        button "Cancel" x=196 y=412 w=80 h=28 role=neutral on-press=cancel size=13
        button "Apply" x=284 y=412 w=80 h=28 role=primary on-press=apply size=13
    }

    // The data section: a scrolling viewport over a stacked column.

    panel name=data-section x=640 y=152 w=376 h=252 fill=base-100 radius=box {
        table name=records x=12 y=12 w=352 h=180 selected=1 on-select=select-record on-activate=edit-record activate-on-click=#false row-height=28 role=primary size=12 {
            column "First" width=110
            column "Last" flex=#true
            column "Born" width=64 align=end

            row "Ada" "Lovelace" "1815"
            row "Grace" "Hopper" "1906"
            row "Alan" "Turing" "1912"
            row "Karen" "Spärck Jones" "1935"
        }

        progress name=loaded x=12 y=204 w=352 h=8 value=0.62 role=info

        label "62% of 4 records indexed" x=12 y=218 w=352 h=16 size=11 role=base-content align=end
    }

    // The media section.

    panel name=media-section x=640 y=416 w=376 h=176 fill=base-100 radius=box {
        image name=logo x=12 y=12 w=120 h=90 src="../assets/showcase.png" fit=contain radius=6

        carousel name=shots x=140 y=12 w=224 h=90 selected=1 on-change=shot-changed auto-advance-ms=4000 role=accent {
            picture src="../assets/screenshots/hello-mac.png" fit=cover
            picture src="../assets/screenshots/gallery.png" fit=contain
            picture src="../assets/screenshots/browser-form.png"
        }

        // A hole in the tree: frames arrive on a hardware plane behind it.
        video name=stream x=12 y=110 w=160 h=54 ground="#11111B"

        radial-progress name=decode x=182 y=110 w=54 h=54 value=0.35 label="35%" thickness=5 role=warning size=11

        avatar name=author x=248 y=110 w=54 h=54 src="../assets/screenshots/pi-hello.jpg" radius=0 presence=busy

        button "⟲" name=retry x=312 y=124 w=52 h=28 role=error on-press=retry no-focus=#true repeat-delay=400 repeat-interval=80 watch-hold=#true corner="F5"
    }

    // A press-absorbing sheet, with no surface of its own: it stops a finger
    // reaching what is behind it and leaves the focus alone. The application
    // shows it when it puts something over the top.
    panel name=scrim x=0 y=0 w=1024 h=600 fill=none border=none backdrop=#true visible=#false z=10
}
